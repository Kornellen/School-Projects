<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Wizytowka_MAUI.MainPage">

    <ScrollView>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
                <ColumnDefinition />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
            </Grid.RowDefinitions>

            <Image Grid.Column="1" WidthRequest="250" Grid.ColumnSpan="2" Source="dotnet_bot.png"/>
            <Label Grid.Column="1" Grid.ColumnSpan="2" Grid.Row="1" HorizontalTextAlignment="Center" Text="Kornel Konopka" FontSize="Large"/>
            <Label Grid.Column="1" Grid.ColumnSpan="2" Grid.Row="2" HorizontalTextAlignment="Center" Text="Krótki Opis w wizytówce wykonanej przeze mnie!" FontSize="Medium" />
            <Label x:Name="greetings_lbl" Grid.Column="1" Grid.ColumnSpan="2" Grid.Row="3" HorizontalTextAlignment="Center" Text="Witaj Świecie!" FontSize="Medium" />
            <Button x:Name="greetings_btn" Grid.Column="1" Grid.ColumnSpan="2" Grid.Row="4" Text="Zmień Powitanie!" FontSize="Medium" TextTransform="Uppercase" TextColor="White" BackgroundColor="#7c8ba3" Margin="10,10,10,100" Clicked="greetings_btn_Clicked" />
        </Grid>
    </ScrollView>

</ContentPage>
