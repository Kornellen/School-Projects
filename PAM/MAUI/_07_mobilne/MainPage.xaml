<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:_07_mobilne.Models"
             x:Class="_07_mobilne.MainPage">

    <ScrollView>
        <VerticalStackLayout BackgroundColor="#f0f8ff">
            <Label Text="Notatki" FontSize="Title" TextColor="MediumBlue"/>
            <CollectionView ItemsSource="{Binding Notes}" HeightRequest="600">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:Note">
                            <VerticalStackLayout Padding="10">
                                <Label Text="{Binding Title}" />
                                <Label Text="{Binding Content}" />
                            </VerticalStackLayout>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
            <VerticalStackLayout VerticalOptions="End">
                <Label Text="Dodanie notatki" FontSize="Large" TextColor="MediumBlue" />
                <Label Text="Tytuł notatki" />
                <Entry x:Name="note_title_entr"/>
                <Label Text="Treść notatki" />
                <Entry x:Name="note_content_entr"/>
                <Button Text="DODAJ" TextColor="MediumBlue" x:Name="add_task_btn" Clicked="add_task_btn_Clicked"/>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
